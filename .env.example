# Environment Variables

# AI API Keys (configure at least one)
# Periscope's default is the free Agnes tier — the one key worth setting:
AGNES_API_KEY=xxx
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
AZURE_OPENAI_API_KEY=xxx
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
GOOGLE_API_KEY=xxx
MINIMAX_API_KEY=xxx
DASHSCOPE_API_KEY=xxx
DOUBAO_API_KEY=xxx
DEEPSEEK_API_KEY=xxx

# WebHook Url (optional for sending notifications)
HORIZON_WEBHOOK_URL=https://xxx

# GitHub Token (optional but recommended for higher rate limits)
# Without token: 60 requests/hour
# With token: 5000 requests/hour
GITHUB_TOKEN=ghp_xxx

# Apify Token (required for Twitter scraping)
# Get yours at https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxx

# Email delivery. Which variable is read is set by `email.password_env` in the
# config (default: EMAIL_PASSWORD). The fork's Resend route documents
# password_env = RESEND_API_KEY; set whichever one your config names.
# Get one at https://resend.com/api-keys  (SMTP style: an app password).
EMAIL_PASSWORD=
RESEND_API_KEY=re_xxx

# Any ${VAR} written inside a config value is expanded from the environment at
# load time (src/storage/manager.py), so a per-feed key like this one also has
# to be exported: "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}"
LWN_KEY=

# Process-level switches read directly by the programs (see
# docs/configuration.md "Process Environment Variables").
# Where the repository lives, used by the MCP server when a tool call does not
# pass horizon_path explicitly.
HORIZON_PATH=
# Explicit MCP secrets file; setting it to a missing path fails loudly instead
# of falling back.
HORIZON_MCP_SECRETS_PATH=
# Profile-preset catalog base URL. The default points at an upstream service
# this fork does not deploy, so override it or go offline below.
HORIZON_API_URL=https://horizon1123.top
# 1/true/yes -> the wizard and preset loading touch no network at all.
HORIZON_OFFLINE=
