# Normalize line endings so a cross-platform suite stops fighting over them:
# the tests now run on Windows too, and CRLF churn made every diff unreadable.
* text=auto eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.graffle binary
*.whl binary
